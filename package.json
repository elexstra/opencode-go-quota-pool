{
  "name": "opencode-go-quota-pool",
  "version": "0.2.0",
  "description": "OpenCode Go 双订阅轮转池 + 用量条：两把 API Key 顺序耗尽，额度打满时切到另一把，用量条显示当前生效槽位的账号用量",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "meta": {
    "title": "配额轮转池",
    "description": "OpenCode Go 的两把 key 顺序耗尽，额度打满自动轮转；用量条跟随当前生效的 key"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode-go",
    "quota",
    "api-key-rotation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elexstra/opencode-go-quota-pool.git"
  },
  "bugs": {
    "url": "https://github.com/elexstra/opencode-go-quota-pool/issues"
  }
}
